{
    "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
    "runtime": { "version": "LuaJIT" },
    "workspace": {
        "checkThirdParty": false,
        "ignoreDir": [".claude", ".deps"],
        "library": [
            "tests/types",
            "${env:VIMRUNTIME}/lua"
        ]
    },
    "diagnostics": {
        "globals": ["describe", "it", "before_each", "after_each", "pending", "setup", "teardown"]
    }
}
